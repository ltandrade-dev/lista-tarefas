# Variáveis de ambiente — Supabase
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA compartilhe ou versione o arquivo .env com valores reais.

# URL pública do projeto Supabase
# Encontre em: Supabase Dashboard > Settings > API > Project URL
VITE_SUPABASE_URL=

# Chave pública anônima (anon key) do Supabase
# Encontre em: Supabase Dashboard > Settings > API > Project API Keys > anon public
# Esta chave é segura para uso no frontend — ela é limitada pelas políticas de Row Level Security (RLS)
VITE_SUPABASE_ANON_KEY=
